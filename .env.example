# Copy to .env and adjust. Load it however you like, e.g.:
#   export $(grep -v '^#' .env | xargs) && go run .

# HTTP
PORT=8080

# Public base URL (used to build the Twitch OAuth redirect + invite/player links).
# Leave empty for local use; defaults to http://localhost:<PORT>.
# Set to your https://… domain when deployed (also enables Secure cookies).
PUBLIC_BASE_URL=

# Storage
DB_PATH=./data/media-share.db     # SQLite database (accounts + login sessions)
MEDIA_DIR=./media                 # uploaded media files
MAX_UPLOAD_MB=100
ALLOWED_MEDIA_EXT=mp4,webm,mov,ogg

# --- Twitch login (REQUIRED) ---
# Register one app at https://dev.twitch.tv/console/apps with the redirect URL
#   http://localhost:8080/auth/twitch/callback   (match PORT / PUBLIC_BASE_URL)
# Streamers (and viewers) then "Log in with Twitch" — no tokens to paste.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Credits (bits → credits) ---
# Shared secret used to HMAC-verify the Twitch EventSub bits/cheer webhook. It must
# match the secret set when the EventSub subscription is created (out-of-band, via
# the Twitch CLI or dashboard, with callback <BASE_URL>/api/webhooks/twitch/eventsub).
TWITCH_EVENTSUB_SECRET=
# Credit economy: 1 bit = 1 credit; a clip costs CREDITS_PER_SECOND per second of
# play length (default 10 → 10s costs 100). Set CREDITS_ENABLED=false to make
# submitting free while testing.
CREDITS_ENABLED=
CREDITS_PER_SECOND=

# Local testing only: set DEV_LOGIN=1 to show password-less "Dev login" buttons
# (streamer + viewer) and enable POST /api/dev/credit to top up credits without
# cheering. Lets you test the whole flow without a Twitch app. Never in production.
DEV_LOGIN=
