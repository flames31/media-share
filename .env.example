# Copy to .env and adjust. Load it however you like, e.g.:
#   export $(grep -v '^#' .env | xargs) && go run .

# HTTP
PORT=8080

# Public base URL (used to build the Twitch OAuth redirect + invite/player links).
# Leave empty for local use; defaults to http://localhost:<PORT>.
# Set to your https://… domain when deployed (also enables Secure cookies).
PUBLIC_BASE_URL=

# Storage
DB_PATH=./data/media-share.db     # SQLite database (accounts + login sessions)
MEDIA_DIR=./media                 # uploaded media files
MAX_UPLOAD_MB=100
ALLOWED_MEDIA_EXT=mp4,webm,mov,ogg

# --- Twitch login (REQUIRED) ---
# Register one app at https://dev.twitch.tv/console/apps with the redirect URL
#   http://localhost:8080/auth/twitch/callback   (match PORT / PUBLIC_BASE_URL)
# Streamers then "Log in with Twitch" — no tokens to paste.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Local testing only: set DEV_LOGIN=1 to show a password-less "Dev login" button
# so you can try the app without registering a Twitch app. Never use in production.
DEV_LOGIN=
